# Copy to .env.local and fill in real values. .env.local is gitignored.
# This file documents placeholders only — no secrets, no Tailscale IPs or
# hostnames beyond the canonical URL already recorded in CLAUDE.md.

# SQLite database file path (see CLAUDE.md: data/ is gitignored).
DATABASE_URL=file:./data/app.db

NODE_ENV=development

# Next.js must bind only to 127.0.0.1 — see CLAUDE.md deployment rules.
HOSTNAME=127.0.0.1
PORT=3000

# Number of days after which an unverified fact is considered stale.
STALE_AFTER_DAYS=180

# Directory for scripts/backup.ts output.
BACKUP_DIR=./data/backups
